{
  "expo": {
    "name": "Rotom-dex",
    "slug": "dex-rotom",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/rotom-icon.png",
    "scheme": "pokedex",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/rotom-icon.png",
        "backgroundColor": "#FA8072"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jamesjiaspringfield107_lab.dexrotom"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/rotom-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/rotom-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FA8072"
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c7f62abc-0ee6-4c70-a860-021c8928d979"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c7f62abc-0ee6-4c70-a860-021c8928d979"
    }
  }
}
