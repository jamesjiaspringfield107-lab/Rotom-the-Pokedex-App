{
  "expo": {
    "name": "Rotom-dex",
    "slug": "dex-rotom",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/rotom-icon.png",
    "scheme": "pokedex",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/rotom-icon.png",
        "backgroundColor": "#FA8072"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/rotom-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/rotom-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FA8072"
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
